{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AUDIRA 3D Simulator",
  "version": "1.0.0",
  "identifier": "id.my.audira.simulator3d",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @audira/web dev",
    "beforeBuildCommand": "pnpm --filter @audira/web build"
  },
  "app": {
    "windows": [
      {
        "title": "AUDIRA 3D CONSTRUCTION SIMULATOR",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
