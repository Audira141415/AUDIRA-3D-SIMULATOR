{
  "name": "audira-3d-construction-simulator-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "3D World Builder + Construction Simulator (Web & Desktop)",
  "scripts": {
    "dev": "pnpm --filter @audira/web --filter @audira/api --parallel dev",
    "dev:web": "pnpm --filter @audira/web dev",
    "dev:api": "pnpm --filter @audira/api dev",
    "dev:desktop": "pnpm --filter @audira/desktop dev",
    "start_web": "pnpm dev",
    "start_app": "pnpm dev:desktop",
    "start:web": "pnpm dev",
    "start:app": "pnpm dev:desktop",
    "scrape:assets": "node scripts/auto-scrape-bangpay.mjs",
    "build": "pnpm --filter @audira/web build",
    "build:all": "pnpm -r run build",
    "build:desktop": "pnpm --filter @audira/desktop build",
    "lint": "pnpm -r run lint",
    "test": "pnpm --filter @audira/web test"
  },
  "packageManager": "pnpm@9.15.0"
}
